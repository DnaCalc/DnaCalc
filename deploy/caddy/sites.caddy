# DNA Calc's sites on the host (dc-ysl; docs/plan/PUBLISHING_PLAN.md and deploy/OWNER_STEPS.md).
# Installed with headers.caddy as /etc/caddy/dnacalc/sites.caddy and headers.caddy, and imported
# from /etc/caddy/Caddyfile by one line, `import /etc/caddy/dnacalc/*.caddy`, in place of the old
# DNA Calc and OneCalc site blocks.
#
# Each site's root is the receiver's `current` symlink (deploy/host/dnacalc-site-receive), so a
# publish or a rollback takes effect without a reload.

# DNA Calc at the apex.
dnacalc.com {
	root * /srv/dnacalc-site/calc/current
	import dnacalc_headers

	@bad_methods not method GET HEAD
	respond @bad_methods 405

	file_server
}

www.dnacalc.com {
	redir https://dnacalc.com{uri} permanent
}

# DNA OneCalc.
onecalc.dnacalc.com {
	root * /srv/dnacalc-site/onecalc/current
	import dnacalc_headers

	@bad_methods not method GET HEAD
	respond @bad_methods 405

	file_server
}
