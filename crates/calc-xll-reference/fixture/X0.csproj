<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ExcelDnaPackageVersion Condition="'$(ExcelDnaPackageVersion)' == ''">1.9.0</ExcelDnaPackageVersion>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <ExcelDnaCreate64BitAddIn>true</ExcelDnaCreate64BitAddIn>
    <ExcelDnaPackExcelDnaConfig>false</ExcelDnaPackExcelDnaConfig>
    <ExcelDnaPublishPath>publish</ExcelDnaPublishPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Probe.cs" />
    <PackageReference Include="ExcelDna.AddIn" Version="$(ExcelDnaPackageVersion)" />
    <Reference Include="Microsoft.CSharp" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
</Project>
