    {"name": "exceldna-pool", "xll": "{fixture}/bin/Release/net48/X2Pool-AddIn64.xll", "sheet": "X0", "cases": "x2-pool-cases.json", "excel": "{excel}/exceldna-pool/controller.jsonl"},
