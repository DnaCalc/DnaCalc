<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>excel-worker</AssemblyName>
    <RootNamespace>Touchstone.Excel</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../../crates/calc-catalogue/tests/fixtures/admission-families.tsv"
                      LogicalName="admission-families.tsv" />
    <EmbeddedResource Include="../../vba-probes/*" LogicalName="vba-probes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../vba-probe-policy.json" LogicalName="vba-probe-policy.json" />
  </ItemGroup>
  <Target Name="AdmitVbaTemplates" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --admit-vba-templates" />
  </Target>
</Project>
