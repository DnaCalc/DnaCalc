{
  "family": "date-time",
  "version": 1,
  "functions": {
    "DATE": {
      "args": [
        {
          "name": "year",
          "kind": "integer",
          "specials": [0, 1, 89, 100, 1899, 1900, 1904, 1999, 2000, 2024, 2100, 9999, 10000, -1],
          "ranges": [[0, 9999]],
          "edges": [
            {
              "value": 0,
              "why": "years 0..1899 add 1900 so year 0 maps to 1900",
              "source": "crates/calc-func/src/ported/date_kernels.rs:113"
            },
            {
              "value": 1899,
              "why": "highest year that adds 1900 (1899 + 1900 = 3799)",
              "source": "crates/calc-func/src/ported/date_kernels.rs:113"
            },
            {
              "value": 1900,
              "why": "first direct 4-digit year; 1900 leap-year artefact",
              "source": "crates/calc-func/src/ported/date_kernels.rs:113"
            },
            {
              "value": 9999,
              "why": "maximum accepted year before #NUM!",
              "source": "crates/calc-func/src/ported/date_kernels.rs:109"
            },
            {
              "value": 10000,
              "why": "rejected with #NUM! even when negative month/day would roll back below 10000",
              "source": "handbook FN-DATE-002"
            }
          ]
        },
        {
          "name": "month",
          "kind": "integer",
          "specials": [-32768, -32767, -15, -1, 0, 1, 2, 3, 12, 13, 14, 32766, 32767],
          "ranges": [[-32766, 32766]],
          "edges": [
            {
              "value": -32767,
              "why": "lower boundary of accepted month interval [-32767, 32767)",
              "source": "crates/calc-func/src/ported/date_kernels.rs:115"
            },
            {
              "value": 0,
              "why": "rolls back to December of previous year",
              "source": "Excel documentation"
            },
            {
              "value": 13,
              "why": "rolls forward to January of next year",
              "source": "Excel documentation"
            },
            {
              "value": 32767,
              "why": "exclusive upper bound; month >= 32767 returns #NUM!",
              "source": "crates/calc-func/src/ported/date_kernels.rs:115"
            }
          ]
        },
        {
          "name": "day",
          "kind": "integer",
          "specials": [-32769, -32768, -15, 0, 1, 28, 29, 30, 31, 35, 32767, 32768],
          "ranges": [[-32768, 32767]],
          "edges": [
            {
              "value": 0,
              "why": "day 0 rolls back to last day of previous month; DATE(1900,1,0) gives serial 0",
              "source": "crates/calc-func/src/ported/date_kernels.rs:57"
            },
            {
              "value": 29,
              "why": "DATE(1900,2,29) yields fictitious serial 60 in 1900 system",
              "source": "handbook FN-DATE-001"
            },
            {
              "value": 32767,
              "why": "day values outside [-32768, 32767] clamp to 32767",
              "source": "crates/calc-func/src/ported/date_kernels.rs:120"
            }
          ]
        }
      ],
      "relations": [
        "1900 <= normalized_year <= 9999",
        "0 <= resulting_1900_serial <= 2958465"
      ],
      "regimes": [
        {
          "name": "short_year_offset",
          "how": "0 <= year < 1900 adds 1900 before month normalization",
          "source": "crates/calc-func/src/ported/date_kernels.rs:113"
        },
        {
          "name": "date_integer_floor_snap",
          "how": "fractional inputs within 2^-22 + 2^-33 (positive) or 2^-23 + 2^-34 (negative) below ceiling snap up",
          "source": "crates/calc-func/src/ported/text_kernels.rs:24"
        },
        {
          "name": "1904_date_system",
          "how": "subtracts 1462 from 1900 serial; dates before 1904-01-01 return #NUM!",
          "source": "crates/calc-func/src/ported/date_kernels.rs:140"
        }
      ],
      "error_edges": [
        {
          "when": "year < 0 or year >= 10000",
          "excel": "#NUM!",
          "source": "crates/calc-func/src/ported/date_kernels.rs:109"
        },
        {
          "when": "month < -32767 or month >= 32767",
          "excel": "#NUM!",
          "source": "crates/calc-func/src/ported/date_kernels.rs:115"
        },
        {
          "when": "normalized serial < 0 or > 2958465 (or < 0 in 1904 system)",
          "excel": "#NUM!",
          "source": "crates/calc-func/src/ported/date_kernels.rs:135"
        }
      ],
      "notes": "Normalizing constructor; 1900-02-29 is serial 60 in 1900 system; year >= 10000 rejected in build 20527 before rollover."
    },
    "TIME": {
      "args": [
        {
          "name": "hour",
          "kind": "integer",
          "specials": [-1, 0, 1, 12, 23, 24, 25, 32767, 32768],
          "ranges": [[-32767, 32767]],
          "edges": [
            {
              "value": 24,
              "why": "wraps modulo 24 hours to 0",
              "source": "Excel documentation"
            },
            {
              "value": 25,
              "why": "TIME(25,0,0) divides total_seconds/86400 before frac, differing by 11 ULP from 1/24",
              "source": "handbook FN-TIME-001"
            },
            {
              "value": 32767,
              "why": "maximum accepted truncated hour magnitude",
              "source": "crates/calc-func/src/ported/date_kernels.rs:157"
            }
          ]
        },
        {
          "name": "minute",
          "kind": "integer",
          "specials": [-60, -1, 0, 1, 30, 59, 60, 1440, 32767, 32768],
          "ranges": [[-32767, 32767]],
          "edges": [
            {
              "value": 32767,
              "why": "maximum accepted truncated minute magnitude",
              "source": "crates/calc-func/src/ported/date_kernels.rs:157"
            }
          ]
        },
        {
          "name": "second",
          "kind": "integer",
          "specials": [-60, -1, 0, 1, 30, 59, 60, 32767, 32768],
          "ranges": [[-32767, 32767]],
          "edges": [
            {
              "value": 32767,
              "why": "maximum accepted truncated second magnitude",
              "source": "crates/calc-func/src/ported/date_kernels.rs:157"
            }
          ]
        }
      ],
      "relations": [
        "hour * 3600 + minute * 60 + second >= 0"
      ],
      "regimes": [
        {
          "name": "wrap_modulo_day",
          "how": "computes (total_seconds / 86400.0).rem_euclid(1.0) after truncating each argument",
          "source": "crates/calc-func/src/ported/date_kernels.rs:156"
        }
      ],
      "error_edges": [
        {
          "when": "abs(trunc(arg)) > 32767 for any argument",
          "excel": "#NUM!",
          "source": "crates/calc-func/src/ported/date_kernels.rs:157"
        },
        {
          "when": "total_seconds < 0",
          "excel": "#NUM!",
          "source": "crates/calc-func/src/ported/date_kernels.rs:161"
        }
      ],
      "notes": "Truncates each argument, rejects |arg| > 32767 or negative total seconds, wraps total_seconds / 86400 modulo 1."
    },
    "YEAR": {
      "args": [
