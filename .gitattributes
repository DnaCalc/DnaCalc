# Files that run or are read on the Linux site host keep LF line endings in every checkout
# (dc-ysl): a CRLF shebang line does not run.
deploy/host/** text eol=lf
deploy/caddy/** text eol=lf
# Keep the captured boundary bytes and their SHA-256 records exact across platforms.
crates/calc-xll-reference/traces/** -text
# Preserve eng14's original authored-entry manifest, including its recorded CRLF bytes.
crates/calc-engine/tests/fixtures/eng14-raw-nonfinite/oracle.entries.json -text whitespace=cr-at-eol
# Retain eng15's original observer source and cumulative trace bytes.
crates/calc-engine/tests/fixtures/excel-calc-probes/P14/eng15-20261104/source/** -text whitespace=cr-at-eol,-blank-at-eof
crates/calc-engine/tests/fixtures/excel-calc-probes/P14/eng15-20261104/traces/** -text whitespace=cr-at-eol
