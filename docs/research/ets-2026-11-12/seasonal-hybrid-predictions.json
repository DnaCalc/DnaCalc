{
  "protocol": "New frozen tests following retrospective exact replay of all three S0 cases. Restricted n8 last-observation impulse family: seasons from unaffected alternating prefix; level y0-S0; initial slope forward raw-moment OLS over ALL deseasonalized observations, not prefix slope. Recurrence gains predicted .126/.001/.001. Not a general seasonal initializer or optimizer.",
  "python_source": "from experiments import *\n\ndef main():\n    rows=[]\n    configs=[(0.,8.,0.,d) for d in [-1.,.125,.5,2.,32.]]\n    configs += [(16.,8.,256.,1.),(0.,16.,0.,1.),(0.,32.,0.,1.),(0.,4.,0.,1.),(0.,.125,0.,1.)]\n    for i,(offset,amplitude,trend,delta) in enumerate(configs):\n        y=[offset+float(j)*trend+(amplitude if j%2 else 0.)+(delta if j==7 else 0.) for j in range(8)]\n        level=offset+amplitude/2.; seasons=[-amplitude/2.,amplitude/2.]\n        adjusted=[v-seasons[j%2] for j,v in enumerate(y)]\n        b0=slope(adjusted)\n        initial=(level,b0,seasons)\n        # Predicted gains are deliberately frozen too. They are inferred from the\n        # homogeneous S0 family; neither an optimizer nor a general initializer is asserted.\n        m=run(y,.126,.001,.001,initial)\n        f=dict(a=.126,b=.001,g=.001,model=m,sse=sse(m))\n        st=stats(y,m)\n        name=f'hybrid_{i}'\n        for stat,value in [(1,.126),(2,.001),(3,.001),(6,st[2]),(7,st[3])]:\n            rows.append(question(name+f'_S{stat}',y,2,'stat',stat,{'prefix_seasons_global_deseasonalized_OLS':val(value)}))\n        for h in [1,2,3]:\n            rows.append(question(name+f'_F{h}',y,2,'forecast',h,{'prefix_seasons_global_deseasonalized_OLS':val(forecast(y,f,h))}))\n        rows.append(question(name+'_Cendpoint',y,2,'endpoint',1,{'prefix_seasons_global_deseasonalized_OLS':val(ci(y,f,1))}))\n    save('seasonal-hybrid-predictions.json',dict(\n      protocol='New frozen tests following retrospective exact replay of all three S0 cases. Restricted n8 last-observation impulse family: seasons from unaffected alternating prefix; level y0-S0; initial slope forward raw-moment OLS over ALL deseasonalized observations, not prefix slope. Recurrence gains predicted .126/.001/.001. Not a general seasonal initializer or optimizer.',\n      python_source=Path(__file__).read_text(),rows=rows))\n    print('Frozen',len(rows),'hybrid-initializer readings')\n\nif __name__=='__main__':main()\n",
