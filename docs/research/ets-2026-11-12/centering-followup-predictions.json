{
  "protocol": "Fresh positive last-impulse cases after retrospective centering audit. Restricted n8/p2 initializer: seasons +/-4, level offset+4, slope OLS(y-season). Application .126/.001/.001, then center=(S0+S1)/2, level+=center, seasons-=center. No reset predicted. Negative-delta hybrid_0 remains a counterexample to the complete program.",
  "python_source": "from experiments import *\nimport copy\n\ndef main():\n    rows=[]\n    for i,(delta,offset,trend) in enumerate([(d,0.,0.) for d in [.25,.75,1.5,3.,6.,12.]]+[(3.,16.,256.)]):\n        y=[offset+j*trend+(8. if j%2 else 0.)+(delta if j==7 else 0.) for j in range(8)]\n        s=[-4.,4.]; l=offset+4.; b0=slope([v-s[j%2] for j,v in enumerate(y)])\n        raw=run(y,.126,.001,.001,(l,b0,s)); centered=copy.deepcopy(raw)\n        center=(centered['seasons'][0]+centered['seasons'][1])/2.\n        centered['level']+=center\n        centered['seasons']=[v-center for v in centered['seasons']]\n        st=stats(y,raw)\n        for stat,value in [(1,.126),(2,.001),(3,.001),(6,st[2]),(7,st[3])]:\n            rows.append(question(f'center_{i}_S{stat}',y,2,'stat',stat,{'hybrid_initializer':val(value)}))\n        for h in [1,2,3]:\n            rows.append(question(f'center_{i}_F{h}',y,2,'forecast',h,{\n              'uncentered':val(forecast(y,dict(model=raw),h)),\n              'centered':val(forecast(y,dict(model=centered),h))}))\n        f=dict(model=raw,a=.126,b=.001,g=.001,sse=sse(raw))\n        rows.append(question(f'center_{i}_Cendpoint',y,2,'endpoint',1,{'hybrid_initializer':val(ci(y,f,1))}))\n    save('centering-followup-predictions.json',dict(\n      protocol='Fresh positive last-impulse cases after retrospective centering audit. Restricted n8/p2 initializer: seasons +/-4, level offset+4, slope OLS(y-season). Application .126/.001/.001, then center=(S0+S1)/2, level+=center, seasons-=center. No reset predicted. Negative-delta hybrid_0 remains a counterexample to the complete program.',\n      python_source=Path(__file__).read_text(),rows=rows))\n    print('Frozen',len(rows),'centering readings')\n\nif __name__=='__main__':main()\n",
