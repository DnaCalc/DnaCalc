    "N2": "=_xlfn.LET(_xlpm.b,B1:B8,_xlpm.f,F1:F8,_xlpm.x,_xlfn._xlws.FILTER(_xlpm.b:_xlpm.f,COUNTIF(_xlpm.b,_xlpm.b)-COUNTIFS(_xlpm.b,_xlpm.b,_xlpm.f,_xlpm.f)+(_xlfn.SEQUENCE(ROWS(_xlpm.b))=_xlfn.XMATCH(_xlpm.b,_xlpm.b))),IF(_xlpm.x=\"\",\"\",_xlpm.x))"
  },
