  "formulas": {
    "N2": "=LET(b,B1:B8,f,F1:F8,x,FILTER(b:f,COUNTIF(b,b)-COUNTIFS(b,b,f,f)+(SEQUENCE(ROWS(b))=XMATCH(b,b))),IF(x=\"\",\"\",x))"
  },
