{
  "id": "regex-count-boundary",
  "kind": "formula",
  "feature": "REGEX",
  "trick": "A negative lookahead prevents counting a word embedded in a longer identifier.",
  "licence": "CC BY-SA 4.0",
  "source": {
    "url": "https://superuser.com/a/1351526",
