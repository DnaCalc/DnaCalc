    "changes": "Synthetic inputs and OOXML formula encoding."
  },
  "inputs": {
    "A1": "doc docs doc. doct"
  },
  "formulas": {
    "N2": "=(LEN(A1)-LEN(RegExReplace(A1,\"(\\W?)doc(?!\\w)\",\"$1\")))/LEN(\"doc\")"
  },
  "stored_formulas": {
    "N2": "=(LEN(A1)-LEN(_xlfn.REGEXREPLACE(A1,\"(\\W?)doc(?!\\w)\",\"$1\")))/LEN(\"doc\")"
  },
